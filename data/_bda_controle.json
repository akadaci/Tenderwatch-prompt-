    "titles": [
     {
      "language": "NL",
      "text": "Deelnemen aan een marktconsultatie in het station van Brussel-Centraal, concept F&B Fast Service"
     },
     {
      "language": "FR",
      "text": "Participation à une consultation de marché dans la gare de Bruxelles-Central, concept F&B Fast Service"
     }
    ]
   },
