   "dossier": {
    "accreditations": {},
    "descriptions": [
     {
      "language": "NL",
      "text": "De opdracht betreft het uitvoeren van een ecohydrologische studie n.a.v. sterke en structurele verdroging in Wijnendalebos, gelegen te Torhout. Doel van de opdracht is om grondig inzicht te krijgen in de hydrografische, hydrologische en ecologische werking van het watersysteem in het studiegebied, met specifieke aandacht voor de impact van een actieve verlaging van de grondwatertafel d.m.v. drainage en vergunde en niet-vergunde grondwateronttrekkingen in de ruime omgeving van het studiegebied op het watersysteem. De resultaten van deze opdracht zullen worden gebruikt voor de ecohydrologische onderbouwing van inrichtingskeuzes die gemaakt worden rond waterbeheer en de ondersteuning van het vergunningen- en handhavingsbeleid m.b.t. grondwateronttrekkingen binnen het studiegebied."
     }
    ],
    "enterpriseCategories": [],
    "legalBasis": "D24",
    "number": "ANB-GP-2026-233",
    "procurementProcedureType": "S_NEG_W_CALL_24_81",
